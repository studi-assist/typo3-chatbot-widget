<?xml version="1.0" encoding="utf-8"?>
<T3DataStructure>
  <sheets>
    <sDEF>
      <ROOT>
        <sheetTitle>Settings</sheetTitle>
        <type>array</type>
        <el>
          <settings.chatbotUrl>
            <label>Chatbot URL (must be https://)</label>
            <config>
              <type>input</type>
              <size>60</size>
              <eval>required,trim</eval>
              <required>1</required>
              <placeholder>https://chat.example.com/chat/de</placeholder>
            </config>
          </settings.chatbotUrl>
          <settings.studyProgram>
            <label>Studiengang (optional – muss Wissensmanager entsprechen)</label>
            <config>
              <type>input</type>
              <size>60</size>
              <eval>trim</eval>
              <placeholder>z.B. Wirtschaftsinformatik</placeholder>
            </config>
          </settings.studyProgram>
          <settings.buttonColor>
            <label>Button Color (gradient start &amp; header)</label>
            <config>
              <type>input</type>
              <renderType>colorpicker</renderType>
              <size>10</size>
              <eval>trim</eval>
              <default>#779EC4</default>
            </config>
          </settings.buttonColor>
          <settings.buttonColorEnd>
            <label>Button Gradient End Color (optional – empty = derived from Button Color)</label>
            <config>
              <type>input</type>
              <renderType>colorpicker</renderType>
              <size>10</size>
              <eval>trim</eval>
            </config>
          </settings.buttonColorEnd>
          <settings.textColor>
            <label>Text &amp; Icon Color</label>
            <config>
              <type>input</type>
              <renderType>colorpicker</renderType>
              <size>10</size>
              <eval>trim</eval>
              <default>#ffffff</default>
            </config>
          </settings.textColor>
          <settings.headerTitle>
            <label>Header Title (shown in chat window)</label>
            <config>
              <type>input</type>
              <size>30</size>
              <eval>trim</eval>
              <default>StudiAssist</default>
              <placeholder>StudiAssist</placeholder>
            </config>
          </settings.headerTitle>
          <settings.iconStyle>
            <label>Launcher Icon</label>
            <config>
              <type>select</type>
              <renderType>selectSingle</renderType>
              <items>
                <numIndex index="0">
                  <numIndex index="0">Chat bubble</numIndex>
                  <numIndex index="1">chat</numIndex>
                </numIndex>
                <numIndex index="1">
                  <numIndex index="0">Sparkle (AI)</numIndex>
                  <numIndex index="1">sparkle</numIndex>
                </numIndex>
                <numIndex index="2">
                  <numIndex index="0">Graduation cap</numIndex>
                  <numIndex index="1">cap</numIndex>
                </numIndex>
                <numIndex index="3">
                  <numIndex index="0">Robot</numIndex>
                  <numIndex index="1">robot</numIndex>
                </numIndex>
              </items>
              <default>chat</default>
            </config>
          </settings.iconStyle>
          <settings.showStatusDot>
            <label>Show Online Status Dot</label>
            <config>
              <type>check</type>
              <default>1</default>
            </config>
          </settings.showStatusDot>
          <settings.statusDotColor>
            <label>Status Dot Color</label>
            <config>
              <type>input</type>
              <renderType>colorpicker</renderType>
              <size>10</size>
              <eval>trim</eval>
              <default>#34c759</default>
            </config>
          </settings.statusDotColor>
          <settings.windowBackgroundColor>
            <label>Chat Window Background Color</label>
            <config>
              <type>input</type>
              <renderType>colorpicker</renderType>
              <size>10</size>
              <eval>trim</eval>
              <default>#ffffff</default>
            </config>
          </settings.windowBackgroundColor>
          <settings.teaserText>
            <label>Teaser Text (optional speech bubble next to the button – empty = off)</label>
            <config>
              <type>input</type>
              <size>60</size>
              <eval>trim</eval>
              <placeholder>z.B. Fragen zum Studium? Ich helfe gern!</placeholder>
            </config>
          </settings.teaserText>
          <settings.showHeader>
            <label>Show Header Bar (off = floating close button instead)</label>
            <config>
              <type>check</type>
              <default>1</default>
            </config>
          </settings.showHeader>
          <settings.windowWidth>
            <label>Window width (240–2000px; empty = responsive default) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.windowWidth>
          <settings.windowHeight>
            <label>Window height (240–2000px; empty = responsive default) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.windowHeight>
          <settings.borderRadius>
            <label>Window border radius (0–100px; empty = 24px desktop / 20px mobile) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.borderRadius>
          <settings.borderColor>
            <label>Window border color (hex; empty = subtle default border) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.borderColor>
          <settings.borderWidth>
            <label>Window border width (0–12px; empty = 1px) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.borderWidth>
          <settings.borderStyle>
            <label>Window border style (empty = solid) – empty = site-wide setting / default</label>
            <config>
              <type>select</type>
              <renderType>selectSingle</renderType>
              <items>
                <numIndex index="0">
                  <numIndex index="0">Automatic / inherit</numIndex>
                  <numIndex index="1"></numIndex>
                </numIndex>
                <numIndex index="1">
                  <numIndex index="0">solid</numIndex>
                  <numIndex index="1">solid</numIndex>
                </numIndex>
                <numIndex index="2">
                  <numIndex index="0">dashed</numIndex>
                  <numIndex index="1">dashed</numIndex>
                </numIndex>
                <numIndex index="3">
                  <numIndex index="0">dotted</numIndex>
                  <numIndex index="1">dotted</numIndex>
                </numIndex>
                <numIndex index="4">
                  <numIndex index="0">double</numIndex>
                  <numIndex index="1">double</numIndex>
                </numIndex>
                <numIndex index="5">
                  <numIndex index="0">none</numIndex>
                  <numIndex index="1">none</numIndex>
                </numIndex>
              </items>
              <default></default>
            </config>
          </settings.borderStyle>
          <settings.headerHeight>
            <label>Header height (32–160px; empty = 52px) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.headerHeight>
          <settings.headerFontSize>
            <label>Header font size (10–32px; empty = 14px) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.headerFontSize>
          <settings.iconColor>
            <label>Icon color (hex; empty = existing colors) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.iconColor>
          <settings.closeIcon>
            <label>Close icon (empty = x) – empty = site-wide setting / default</label>
            <config>
              <type>select</type>
              <renderType>selectSingle</renderType>
              <items>
                <numIndex index="0">
                  <numIndex index="0">Automatic / inherit</numIndex>
                  <numIndex index="1"></numIndex>
                </numIndex>
                <numIndex index="1">
                  <numIndex index="0">x</numIndex>
                  <numIndex index="1">x</numIndex>
                </numIndex>
                <numIndex index="2">
                  <numIndex index="0">minus</numIndex>
                  <numIndex index="1">minus</numIndex>
                </numIndex>
                <numIndex index="3">
                  <numIndex index="0">chevron-down</numIndex>
                  <numIndex index="1">chevron-down</numIndex>
                </numIndex>
              </items>
              <default></default>
            </config>
          </settings.closeIcon>
          <settings.newTabIcon>
            <label>New-tab icon (empty = external-link in header, no link without header) – empty = site-wide setting / default</label>
            <config>
              <type>select</type>
              <renderType>selectSingle</renderType>
              <items>
                <numIndex index="0">
                  <numIndex index="0">Automatic / inherit</numIndex>
                  <numIndex index="1"></numIndex>
                </numIndex>
                <numIndex index="1">
                  <numIndex index="0">external-link</numIndex>
                  <numIndex index="1">external-link</numIndex>
                </numIndex>
                <numIndex index="2">
                  <numIndex index="0">arrow-up-right</numIndex>
                  <numIndex index="1">arrow-up-right</numIndex>
                </numIndex>
              </items>
              <default></default>
            </config>
          </settings.newTabIcon>
          <settings.launcherIconSize>
            <label>Launcher icon size (16–48px; empty = 42px desktop / 34px mobile) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.launcherIconSize>
          <settings.headerIconSize>
            <label>Header / floating icon size (12–32px; empty = 15px / 16px) – empty = site-wide setting / default</label>
            <config>
              <type>input</type>
              <size>20</size>
              <eval>trim</eval>
            </config>
          </settings.headerIconSize>
          <settings.requireConsent>
            <label>Two-Click Consent (load nothing external until the visitor clicks "Chat starten") – unchecked = site-wide setting applies</label>
            <config>
              <type>check</type>
              <default>0</default>
            </config>
          </settings.requireConsent>
          <settings.consentText>
            <label>Consent Text German (optional – empty = default notice)</label>
            <config>
              <type>text</type>
              <rows>4</rows>
              <cols>60</cols>
              <eval>trim</eval>
            </config>
          </settings.consentText>
          <settings.consentTextEn>
            <label>Consent Text English (optional – shown to non-German browsers; empty = German custom text if set, else default notice)</label>
            <config>
              <type>text</type>
              <rows>4</rows>
              <cols>60</cols>
              <eval>trim</eval>
            </config>
          </settings.consentTextEn>
          <settings.privacyPolicyUrl>
            <label>Privacy Policy URL (optional – linked on the consent screen)</label>
            <config>
              <type>input</type>
              <size>60</size>
              <eval>trim</eval>
              <placeholder>https://www.example.edu/datenschutz</placeholder>
            </config>
          </settings.privacyPolicyUrl>
        </el>
      </ROOT>
    </sDEF>
  </sheets>
</T3DataStructure>
