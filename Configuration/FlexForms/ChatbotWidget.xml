<?xml version="1.0" encoding="utf-8"?>
<T3DataStructure>
  <sheets>
    <sDEF>
      <ROOT>
        <sheetTitle>Settings</sheetTitle>
        <type>array</type>
        <el>
          <settings.chatbotUrl>
            <label>Chatbot URL (must be https://)</label>
            <config>
              <type>input</type>
              <size>60</size>
              <eval>required,trim</eval>
              <required>1</required>
              <placeholder>https://chat.example.com/chat/de</placeholder>
            </config>
          </settings.chatbotUrl>
          <settings.buttonColor>
            <label>Button &amp; Header Color</label>
            <config>
              <type>input</type>
              <renderType>colorpicker</renderType>
              <size>10</size>
              <eval>trim</eval>
              <default>#779EC4</default>
            </config>
          </settings.buttonColor>
          <settings.textColor>
            <label>Text &amp; Icon Color</label>
            <config>
              <type>input</type>
              <renderType>colorpicker</renderType>
              <size>10</size>
              <eval>trim</eval>
              <default>#ffffff</default>
            </config>
          </settings.textColor>
          <settings.headerTitle>
            <label>Header Title (shown in chat window)</label>
            <config>
              <type>input</type>
              <size>30</size>
              <eval>trim</eval>
              <default>StudiAssist</default>
              <placeholder>StudiAssist</placeholder>
            </config>
          </settings.headerTitle>
        </el>
      </ROOT>
    </sDEF>
  </sheets>
</T3DataStructure>