plugin.tx_studiassistchatbot_widget {
  # Empty/unchecked consent fields in a plugin's FlexForm fall back to the
  # site-wide constants instead of overriding them, so requireConsent = 1 set
  # for the site cannot be switched off by a plugin element saved with "0"
  ignoreFlexFormSettingsIfEmpty = requireConsent,consentText,consentTextEn,privacyPolicyUrl

  view {
    templateRootPaths.0 = EXT:studi_assist_chatbot/Resources/Private/Templates/
    partialRootPaths.0 = EXT:studi_assist_chatbot/Resources/Private/Partials/
    layoutRootPaths.0 = EXT:studi_assist_chatbot/Resources/Private/Layouts/
  }

  settings {
    chatbotUrl = {$plugin.tx_studiassistchatbot_widget.settings.chatbotUrl}
    studyProgram = {$plugin.tx_studiassistchatbot_widget.settings.studyProgram}
    buttonColor = {$plugin.tx_studiassistchatbot_widget.settings.buttonColor}
    buttonColorEnd = {$plugin.tx_studiassistchatbot_widget.settings.buttonColorEnd}
    textColor = {$plugin.tx_studiassistchatbot_widget.settings.textColor}
    headerTitle = {$plugin.tx_studiassistchatbot_widget.settings.headerTitle}
    iconStyle = {$plugin.tx_studiassistchatbot_widget.settings.iconStyle}
    showStatusDot = {$plugin.tx_studiassistchatbot_widget.settings.showStatusDot}
    statusDotColor = {$plugin.tx_studiassistchatbot_widget.settings.statusDotColor}
    windowBackgroundColor = {$plugin.tx_studiassistchatbot_widget.settings.windowBackgroundColor}
    teaserText = {$plugin.tx_studiassistchatbot_widget.settings.teaserText}
    showHeader = {$plugin.tx_studiassistchatbot_widget.settings.showHeader}
    windowWidth = {$plugin.tx_studiassistchatbot_widget.settings.windowWidth}
    windowHeight = {$plugin.tx_studiassistchatbot_widget.settings.windowHeight}
    borderRadius = {$plugin.tx_studiassistchatbot_widget.settings.borderRadius}
    borderColor = {$plugin.tx_studiassistchatbot_widget.settings.borderColor}
    borderWidth = {$plugin.tx_studiassistchatbot_widget.settings.borderWidth}
    borderStyle = {$plugin.tx_studiassistchatbot_widget.settings.borderStyle}
    headerHeight = {$plugin.tx_studiassistchatbot_widget.settings.headerHeight}
    headerFontSize = {$plugin.tx_studiassistchatbot_widget.settings.headerFontSize}
    iconColor = {$plugin.tx_studiassistchatbot_widget.settings.iconColor}
    closeIcon = {$plugin.tx_studiassistchatbot_widget.settings.closeIcon}
    newTabIcon = {$plugin.tx_studiassistchatbot_widget.settings.newTabIcon}
    launcherIconSize = {$plugin.tx_studiassistchatbot_widget.settings.launcherIconSize}
    headerIconSize = {$plugin.tx_studiassistchatbot_widget.settings.headerIconSize}
    requireConsent = {$plugin.tx_studiassistchatbot_widget.settings.requireConsent}
    consentText = {$plugin.tx_studiassistchatbot_widget.settings.consentText}
    consentTextEn = {$plugin.tx_studiassistchatbot_widget.settings.consentTextEn}
    privacyPolicyUrl = {$plugin.tx_studiassistchatbot_widget.settings.privacyPolicyUrl}
  }
}

# Global chatbot widget (enabled via Constant Editor: enableGlobal = 1)
[{$plugin.tx_studiassistchatbot_widget.settings.enableGlobal} == 1]
  page.includeJSFooter.studiAssistChatbot = EXT:studi_assist_chatbot/Resources/Public/JavaScript/widget-loader.js

  page.footerData.1638472 = COA
  page.footerData.1638472 {
    10 = TEXT
    10.value (
      <div class="studi-assist-chatbot-root"
           data-button-color="{$plugin.tx_studiassistchatbot_widget.settings.buttonColor}"
           data-button-color-end="{$plugin.tx_studiassistchatbot_widget.settings.buttonColorEnd}"
           data-text-color="{$plugin.tx_studiassistchatbot_widget.settings.textColor}"
           data-icon-style="{$plugin.tx_studiassistchatbot_widget.settings.iconStyle}"
           data-status-dot-color="{$plugin.tx_studiassistchatbot_widget.settings.statusDotColor}"
           data-show-status-dot="{$plugin.tx_studiassistchatbot_widget.settings.showStatusDot}"
           data-window-background-color="{$plugin.tx_studiassistchatbot_widget.settings.windowBackgroundColor}"
           data-show-header="{$plugin.tx_studiassistchatbot_widget.settings.showHeader}"
           data-require-consent="{$plugin.tx_studiassistchatbot_widget.settings.requireConsent}"
    )

    # Free-text settings and URLs are HTML-escaped so a quote or "<" in the
    # value cannot break the markup. preserveEntities keeps values that already
    # contain entities (e.g. &uuml;) rendering exactly as before
    15 = TEXT
    15.value = {$plugin.tx_studiassistchatbot_widget.settings.chatbotUrl}
    15.htmlSpecialChars = 1
    15.htmlSpecialChars.preserveEntities = 1
    15.noTrimWrap = | data-chatbot-url="|"|

    20 = TEXT
    20.value = {$plugin.tx_studiassistchatbot_widget.settings.studyProgram}
    20.htmlSpecialChars = 1
    20.htmlSpecialChars.preserveEntities = 1
    20.noTrimWrap = | data-study-program="|"|

    30 = TEXT
    30.value = {$plugin.tx_studiassistchatbot_widget.settings.headerTitle}
    30.htmlSpecialChars = 1
    30.htmlSpecialChars.preserveEntities = 1
    30.noTrimWrap = | data-header-title="|"|

    40 = TEXT
    40.value = {$plugin.tx_studiassistchatbot_widget.settings.teaserText}
    40.htmlSpecialChars = 1
    40.htmlSpecialChars.preserveEntities = 1
    40.noTrimWrap = | data-teaser-text="|"|

    50 = TEXT
    50.value = {$plugin.tx_studiassistchatbot_widget.settings.consentText}
    50.htmlSpecialChars = 1
    50.htmlSpecialChars.preserveEntities = 1
    50.noTrimWrap = | data-consent-text="|"|

    60 = TEXT
    60.value = {$plugin.tx_studiassistchatbot_widget.settings.consentTextEn}
    60.htmlSpecialChars = 1
    60.htmlSpecialChars.preserveEntities = 1
    60.noTrimWrap = | data-consent-text-en="|"|

    70 = TEXT
    70.value = {$plugin.tx_studiassistchatbot_widget.settings.privacyPolicyUrl}
    70.htmlSpecialChars = 1
    70.htmlSpecialChars.preserveEntities = 1
    70.noTrimWrap = | data-privacy-policy-url="|"|

    100 = TEXT
    100.value = {$plugin.tx_studiassistchatbot_widget.settings.windowWidth}
    100.htmlSpecialChars = 1
    100.noTrimWrap = | data-window-width="|"|

    101 = TEXT
    101.value = {$plugin.tx_studiassistchatbot_widget.settings.windowHeight}
    101.htmlSpecialChars = 1
    101.noTrimWrap = | data-window-height="|"|

    102 = TEXT
    102.value = {$plugin.tx_studiassistchatbot_widget.settings.borderRadius}
    102.htmlSpecialChars = 1
    102.noTrimWrap = | data-border-radius="|"|

    103 = TEXT
    103.value = {$plugin.tx_studiassistchatbot_widget.settings.borderColor}
    103.htmlSpecialChars = 1
    103.noTrimWrap = | data-border-color="|"|

    104 = TEXT
    104.value = {$plugin.tx_studiassistchatbot_widget.settings.borderWidth}
    104.htmlSpecialChars = 1
    104.noTrimWrap = | data-border-width="|"|

    105 = TEXT
    105.value = {$plugin.tx_studiassistchatbot_widget.settings.borderStyle}
    105.htmlSpecialChars = 1
    105.noTrimWrap = | data-border-style="|"|

    106 = TEXT
    106.value = {$plugin.tx_studiassistchatbot_widget.settings.headerHeight}
    106.htmlSpecialChars = 1
    106.noTrimWrap = | data-header-height="|"|

    107 = TEXT
    107.value = {$plugin.tx_studiassistchatbot_widget.settings.headerFontSize}
    107.htmlSpecialChars = 1
    107.noTrimWrap = | data-header-font-size="|"|

    108 = TEXT
    108.value = {$plugin.tx_studiassistchatbot_widget.settings.iconColor}
    108.htmlSpecialChars = 1
    108.noTrimWrap = | data-icon-color="|"|

    109 = TEXT
    109.value = {$plugin.tx_studiassistchatbot_widget.settings.closeIcon}
    109.htmlSpecialChars = 1
    109.noTrimWrap = | data-close-icon="|"|

    110 = TEXT
    110.value = {$plugin.tx_studiassistchatbot_widget.settings.newTabIcon}
    110.htmlSpecialChars = 1
    110.noTrimWrap = | data-new-tab-icon="|"|

    111 = TEXT
    111.value = {$plugin.tx_studiassistchatbot_widget.settings.launcherIconSize}
    111.htmlSpecialChars = 1
    111.noTrimWrap = | data-launcher-icon-size="|"|

    112 = TEXT
    112.value = {$plugin.tx_studiassistchatbot_widget.settings.headerIconSize}
    112.htmlSpecialChars = 1
    112.noTrimWrap = | data-header-icon-size="|"|

    200 = TEXT
    200.value = ></div>
  }
[end]
