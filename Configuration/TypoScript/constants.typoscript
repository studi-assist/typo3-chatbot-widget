plugin.tx_studiassistchatbot_widget {
  settings {
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=boolean; label=Enable Global: Show chatbot widget on all pages without adding it as a plugin
    enableGlobal = 0
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=string; label=Chatbot URL
    chatbotUrl =
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=string; label=Study Program (optional, appended as ?sp=)
    studyProgram =
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=color; label=Button Color (gradient start and header)
    buttonColor = #779EC4
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=string; label=Button Gradient End Color (optional, empty = derived from Button Color)
    buttonColorEnd =
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=color; label=Text and Icon Color
    textColor = #ffffff
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=string; label=Header Title
    headerTitle = StudiAssist
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=options[Chat bubble=chat,Sparkle (AI)=sparkle,Graduation cap=cap,Robot=robot,Arrow up=arrow-up]; label=Launcher Icon
    iconStyle = chat
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=boolean; label=Show Online Status Dot
    showStatusDot = 1
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=color; label=Status Dot Color
    statusDotColor = #34c759
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=color; label=Chat Window Background Color
    windowBackgroundColor = #ffffff
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=string; label=Teaser Text (optional speech bubble next to the button, empty = off)
    teaserText =
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=boolean; label=Show Header Bar (off = floating close button instead)
    showHeader = 1
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Window width (240–2000px, empty = 600px desktop / 500px tablet)
    windowWidth =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Window height (240–2000px, empty = responsive default)
    windowHeight =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Window border radius (0–100px, empty = 24px desktop / 20px mobile)
    borderRadius =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Window border color (hex, empty = subtle default border)
    borderColor =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Window border width (0–12px, empty = 1px)
    borderWidth =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=options[Automatic=,solid,dashed,dotted,double,none]; label=Window border style (empty = solid)
    borderStyle =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Header height (32–160px, empty = 52px)
    headerHeight =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Header font size (10–32px, empty = 14px)
    headerFontSize =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Icon color (hex, empty = existing colors)
    iconColor =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=options[Automatic=,x,minus,chevron-down,Thin X=close-thin]; label=Close icon (empty = x)
    closeIcon =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=options[Automatic=,external-link,arrow-up-right,External link (double)=external-link-double]; label=New-tab icon (empty = external-link in header, no link without header)
    newTabIcon =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Launcher icon size (16–48px, empty = 42px desktop / 34px mobile)
    launcherIconSize =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Header / floating icon size (12–32px, empty = 15px / 16px)
    headerIconSize =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Launcher logo file URL (optional, overrides launcher icon)
    launcherIconUrl =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=Close icon file URL (optional, header and launcher)
    closeIconUrl =
    # cat=plugin.tx_studiassistchatbot_widget/appearance; type=string; label=New-tab icon file URL (optional, also enables headerless link)
    newTabIconUrl =
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=boolean; label=Two-Click Consent: Load nothing external (no status check, no iframe) until the visitor clicks "Chat starten"
    requireConsent = 0
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=string; label=Consent Text German (optional, empty = default notice)
    consentText =
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=string; label=Consent Text English (optional, shown to non-German browsers; empty = German custom text if set, else default notice)
    consentTextEn =
    # cat=plugin.tx_studiassistchatbot_widget/settings; type=string; label=Privacy Policy URL (optional, linked on the consent screen)
    privacyPolicyUrl =
  }
}
